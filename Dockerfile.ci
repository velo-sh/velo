# syntax=docker/dockerfile:1.4
# =============================================================================
# Velo Local CI Image (Optimized)
# =============================================================================
# Uses velo-ci-base for toolchain, adds BuildKit cache for fast rebuilds
#
# Prerequisites:
#   docker build -t velo-ci-base -f Dockerfile.base .
#
# Build:
#   DOCKER_BUILDKIT=1 docker build -t velo-ci -f Dockerfile.ci .
#
# Run:
#   ./scripts/docker-ci.sh
# =============================================================================

ARG BASE_IMAGE=velo-ci-base
FROM ${BASE_IMAGE}

# Metadata
LABEL maintainer="velo-sh" \
    description="Velo CI runner with BuildKit cache optimization"

# CI environment
ENV GITHUB_ACTIONS=true
ENV CI=true
ENV VELO_ENV=ci
ENV CARGO_INCREMENTAL=0
ENV RUST_BACKTRACE=1

WORKDIR /workspace

# Stage 1: Recipe Creation (FAST)
FROM ${BASE_IMAGE} AS planner
WORKDIR /workspace
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# Stage 2: Dependency Builder (CACHED)
FROM ${BASE_IMAGE} AS cacher
WORKDIR /workspace
COPY --from=planner /workspace/recipe.json recipe.json
# Copy vendor directory for path dependencies (granian-core)
COPY vendor/ vendor/
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/workspace/target \
    cargo chef cook --release --recipe-path recipe.json

# Stage 3: Real Builder
FROM ${BASE_IMAGE} AS builder
WORKDIR /workspace
# CI environment for builder stage
ENV CI=true
ENV GITHUB_ACTIONS=true
ENV PYO3_PYTHON=/workspace/.venv/bin/python3
COPY . .
# NOTE: Mount cache is shared between stages, so dependencies from cacher are available

# Create Python venv FIRST so PYO3_PYTHON is valid during cargo build
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync

# HARDENING: Sabotage system python to ensure only venv is used
# This forces developers and scripts to use /workspace/.venv/bin/python3
RUN mv /usr/bin/python3 /usr/bin/python3-SYSTEM-RESTRICTED && \
    printf '#!/bin/bash\necho "[FATAL] CI-Sovereignty: System Python usage detected! Use .venv/bin/python instead." >&2\nexit 1\n' > /usr/bin/python3 && \
    chmod +x /usr/bin/python3

# Rebuild with real source (using cached dependencies)
# Build both release AND debug for tests that use target/debug/velo
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/workspace/target \
    cargo build --release && \
    cargo build && \
    cp target/release/velo ./velo-bin 2>/dev/null || true


# Default: run local-ci.sh (SSOT for CI logic)
CMD ["bash", "scripts/local-ci.sh"]
