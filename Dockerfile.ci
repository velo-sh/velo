FROM ubuntu:22.04

# Environment variables to mimic GitHub Actions
ENV GITHUB_ACTIONS=true
ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.cargo/bin:/root/.local/bin:${PATH}"

# Install strict dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    build-essential \
    pkg-config \
    libssl-dev \
    python3 \
    python3-pip \
    python3-venv \
    # Key libraries for Velo
    libseccomp-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Rust (same as actions-rs/toolchain)
# Pre-install specific version + components to avoid repeated downloads
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.92.0
ENV PATH="/root/.cargo/bin:${PATH}"
RUN rustup component add clippy rustfmt llvm-tools-preview

# Install uv (Modern Python Manager)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# Create CI workspace
WORKDIR /workspace

# Pre-install dependencies (optional optimization)
# COPY Cargo.toml Cargo.lock ./
# RUN mkdir src && echo "fn main() {}" > src/main.rs && cargo build --release && rm -rf src

# Default command: run full CI check with FAIL FAST
CMD ["bash", "-c", "\
    echo '' && \
    echo '🚀 Velo Local CI Simulation (Ubuntu 22.04)' && \
    echo '===========================================' && \
    echo '' && \
    echo '==================== Phase 0: Environment Check (FAIL FAST) ====================' && \
    echo '' && \
    echo '▶ Checking environment...' && \
    uname -a && \
    rustc --version && \
    uv --version && \
    echo '✅ Environment OK' && \
    echo '' && \
    echo '==================== Phase 1: Setup ====================' && \
    echo '' && \
    echo '▶ Setting up Python environment...' && \
    uv sync --no-dev && \
    echo '✅ Python environment ready' && \
    echo '' && \
    echo '==================== Phase 2: Build ====================' && \
    echo '' && \
    echo '▶ Building Rust (release)...' && \
    cargo build --release && \
    echo '✅ Rust build complete' && \
    echo '' && \
    echo '==================== Phase 3: Test ====================' && \
    echo '' && \
    echo '▶ Running Rust tests...' && \
    cargo test --lib && \
    echo '✅ Rust tests passed' && \
    echo '' && \
    echo '▶ Running Python tests...' && \
    . .venv/bin/activate && \
    echo '' && \
    echo '--- QA: Basic Harness ---' && \
    pytest tests/qa/test_harness.py tests/qa/test_fingerprint.py -v --tb=short && \
    echo '' && \
    echo '--- Phase 7.0: Memory Gravity ---' && \
    pytest tests/qa/phase_7_0/ -v --tb=short && \
    echo '' && \
    echo '--- Phase 6.2: Environment & Regression ---' && \
    pytest tests/qa/test_phase6_2_env_pollution.py tests/qa/test_phase6_2_regression.py -v --tb=short && \
    echo '' && \
    echo '--- Phase 6.1: Security Hardened ---' && \
    pytest tests/qa/test_phase6_1_security_hardened.py -v --tb=short && \
    echo '' && \
    echo '--- Phase 6.1: Stability Hardened ---' && \
    pytest tests/qa/test_phase6_1_stability_hardened.py -v --tb=short && \
    echo '' && \
    echo '✅ All Python tests passed' && \
    echo '' && \
    echo '==================== Phase 4: Lint ====================' && \
    echo '' && \
    echo '▶ Running Clippy...' && \
    cargo clippy -- -D warnings && \
    echo '✅ Clippy passed' && \
    echo '' && \
    echo '▶ Checking format...' && \
    cargo fmt --check && \
    echo '✅ Format OK' && \
    echo '' && \
    echo '==========================================' && \
    echo '✅ ALL CI CHECKS PASSED!' && \
    echo '==========================================' \
    "]
