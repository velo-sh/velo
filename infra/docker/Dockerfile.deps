# syntax=docker/dockerfile:1.4
# =============================================================================
# Velo CI Dependencies Image (Layer 2)
# =============================================================================
# Pre-compiles all Rust dependencies directly (simpler than cargo-chef)
# Built on top of velo-ci-base (Layer 1)
#
# Rebuild triggers: Cargo.toml, Cargo.lock changes
# =============================================================================

ARG BASE_IMAGE=ghcr.io/velo-sh/velo-ci-base:latest
FROM ${BASE_IMAGE}

WORKDIR /cargo-cache

# Copy dependency files
COPY Cargo.toml Cargo.lock ./
COPY vendor ./vendor

# Create a minimal dummy project to compile dependencies
RUN mkdir -p src && \
    echo 'fn main() { println!("placeholder"); }' > src/main.rs

# Build dependencies in release mode
# This compiles all dependencies and caches them in /cargo-cache/target
RUN cargo build --release --all-features 2>&1 || true && \
    echo "Target size: $(du -sh target 2>/dev/null || echo 'N/A')"

# Clean up the dummy source but keep target with compiled deps
RUN rm -rf src

# Verify the target exists
RUN ls -la /cargo-cache/ && ls -la /cargo-cache/target/release/ | head -20

# Metadata
LABEL maintainer="velo-sh" \
    description="Velo CI with pre-compiled dependencies at /cargo-cache/target"

CMD ["bash", "-c", "echo 'Deps cached at /cargo-cache/target'"]
