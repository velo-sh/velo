#!/bin/sh
# Pre-commit hook for Velo
# Run format, lint, and test checks before commit
# IMPORTANT: These commands MUST match CI (.github/workflows/ci.yml)

set -e

echo "🔍 Running cargo fmt..."
cargo fmt --check || {
    echo "❌ Format check failed. Run 'cargo fmt' to fix."
    exit 1
}

echo "🔍 Running cargo clippy (Single Source of Truth: Cargo.toml)..."
cargo clippy --all-targets --all-features -- -D warnings || {
    echo "❌ Clippy check failed. Fix the warnings above."
    exit 1
}

echo "🔍 Running cargo test (lib only for speed)..."
cargo test --lib || {
    echo "❌ Tests failed. Fix the tests above."
    exit 1
}

# -------------------------------------------------------------------
# KINETIC GUARDRAILS (RFC-0013 Compliance)
# -------------------------------------------------------------------
echo "🏗️  Enforcing fresh build for path alignment..."
cargo build --quiet || {
    echo "❌ Build failed. Please fix compilation issues."
    exit 1
}

# Detect changes in Zygote or Serve core
DIFF_FILES=$(git diff --cached --name-only)
if echo "$DIFF_FILES" | grep -qE "velo_zygote/|src/zygote/|src/serve/"; then
    echo "🧪 Kinetic/Zygote core changed. Running Agent D CHAOS suite..."
    
    # Set path to local debug binary to ensure path alignment
    export PATH="$(pwd)/target/debug:$PATH"
    
    uv run pytest tests/qa/test_phase6_2_agent_d_destroyer.py --quiet || {
        echo "❌ KINETIC REGRESSION DETECTED!"
        echo "   The Agent D CHAOS suite failed. This is likely a timing or pollution issue."
        echo "   Please verify your changes and resolve the regression before committing."
        exit 1
    }
    echo "✅ Agent D CHAOS suite passed."
fi

echo "✅ All pre-commit checks passed!"
