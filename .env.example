# Velo Environment Overrides (.env.example)
# Copy this file to .env and customize for your local setup.

# Comma-separated list of packages to preload in Zygote
# VELO_PRELOAD=fastapi,pydantic,uvicorn

# Maximum bundle size in MB
# VELO_MAX_BUNDLE_SIZE=512

# Zygote worker timeout in seconds
# VELO_ZYGOTE_WORKER_TIMEOUT=30

# Zygote socket startup timeout in seconds (increase if slow on local machine)
# VELO_ZYGOTE_SOCKET_TIMEOUT=30
